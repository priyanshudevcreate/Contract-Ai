# ContractGPT Environment Variables for Vercel Deployment
# Copy these to your Vercel project settings

# JWT Configuration (REQUIRED - Generate strong secrets)
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=production

# Frontend URL (Replace with your actual Vercel deployment URL)
FRONTEND_URL=https://your-project-name.vercel.app

# File Upload Configuration
MAX_FILE_SIZE=10485760

# Optional: If using external database
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/contractgpt

# Optional: Rate limiting configuration
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Instructions:
# 1. Copy these variables to your Vercel project dashboard
# 2. Replace placeholder values with actual values
# 3. Generate a strong JWT_SECRET (use a password generator)
# 4. Update FRONTEND_URL with your actual Vercel deployment URL